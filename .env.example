# -----------------------------
# PriceOrbit Environment Config
# -----------------------------

# App
APP_NAME=PriceOrbit API
VERSION=1.0.0
DEBUG=False
DEPLOY_ENV=production
PORT=8080
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=mysql+pymysql://username:password@hostname:3306/priceorbit_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=priceorbit_db

# Kroger API
KROGER_CLIENT_ID=replace-me
KROGER_CLIENT_SECRET=replace-me
KROGER_BASE_URL=https://api.kroger.com/v1
KROGER_AUTH_URL=https://api.kroger.com/v1/connect/oauth2/token
KROGER_MIN_MATCH_CONFIDENCE=70.0
KROGER_CERT_MIN_MATCH_CONFIDENCE=55.0
KROGER_ALIAS_MIN_MATCH_CONFIDENCE=45.0
KROGER_SKIP_UNMATCHED_RETRIES=False
KROGER_OVERRIDE_FILE=data/kroger_product_overrides.json
KROGER_ALIAS_FILE=data/kroger_search_aliases.json

# Scheduler
PRICE_UPDATE_JOB_ENABLED=True
PRICE_UPDATE_CRON_HOUR_UTC=6
PRICE_UPDATE_BATCH_SIZE=10
PRICE_UPDATE_DELAY_SECONDS=2.0
PRICE_UPDATE_MAX_DAILY_CALLS=500
